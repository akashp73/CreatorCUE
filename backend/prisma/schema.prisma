generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SubscriptionPlan {
  id                      String   @id @default(uuid())
  name                    String   @unique
  price_monthly           Int
  max_leads               Int
  max_users               Int
  max_campaigns_per_month Int
  has_whatsapp            Boolean  @default(false)
  has_payments            Boolean  @default(false)
  has_white_label         Boolean  @default(false)
  has_applicant_portal    Boolean  @default(false)
  created_at              DateTime @default(now())
  institutions            Institution[]
  subscriptions           Subscription[]
}

model Institution {
  id            String   @id @default(uuid())
  name          String
  subdomain     String   @unique
  logo_url      String?
  primary_color String   @default("#1B2B4B")
  plan_id       String
  api_key       String   @unique @default(uuid())
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  plan          SubscriptionPlan @relation(fields: [plan_id], references: [id])
  users         User[]
  leads         Lead[]
  scoreRules    ScoreRule[]
  emailTemplates     EmailTemplate[]
  whatsappTemplates  WhatsappTemplate[]
  workflows     Workflow[]
  campaigns     Campaign[]
  payments      Payment[]
  usageMetrics  UsageMetric[]
  subscriptions Subscription[]
  portalUsers   ApplicantPortalUser[]
  assignmentConfig AssignmentConfig?
  assignmentRules  AssignmentRule[]
}

model Subscription {
  id                       String   @id @default(uuid())
  institution_id           String   @unique
  plan_id                  String
  status                   String   @default("ACTIVE")
  started_at               DateTime @default(now())
  expires_at               DateTime
  razorpay_subscription_id String?
  created_at               DateTime @default(now())
  institution              Institution    @relation(fields: [institution_id], references: [id])
  plan                     SubscriptionPlan @relation(fields: [plan_id], references: [id])
}

model UsageMetric {
  id             String   @id @default(uuid())
  institution_id String
  month          String
  leads_created  Int      @default(0)
  campaigns_sent Int      @default(0)
  users_active   Int      @default(0)
  updated_at     DateTime @updatedAt
  institution    Institution @relation(fields: [institution_id], references: [id])
  @@unique([institution_id, month])
}

model User {
  id             String   @id @default(uuid())
  institution_id String
  name           String
  email          String
  password_hash  String
  role           String   @default("COUNSELLOR")
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
  assigned_leads  Lead[]
  tasks           Task[]
  notes           Note[]
  deviceTokens    DeviceToken[]
  assignmentRules AssignmentRule[]
  @@unique([institution_id, email])
}

model Lead {
  id                String    @id @default(uuid())
  institution_id    String
  assigned_to       String?
  name              String
  email             String?
  phone             String
  city              String?
  course_interested String?
  source            String    @default("OTHER")
  status            String    @default("NEW")
  activity_score    Int       @default(0)
  score_label       String    @default("COLD")
  last_activity_at  DateTime  @default(now())
  is_deleted        Boolean   @default(false)
  portal_invited    Boolean   @default(false)
  created_at        DateTime  @default(now())
  updated_at        DateTime  @updatedAt
  institution       Institution @relation(fields: [institution_id], references: [id])
  assignee          User?     @relation(fields: [assigned_to], references: [id])
  activityLogs      ActivityLog[]
  tasks             Task[]
  notes             Note[]
  communicationLogs CommunicationLog[]
  payments          Payment[]
  documents         Document[]
  portalUser        ApplicantPortalUser?
  @@unique([institution_id, phone])
}

model ActivityLog {
  id            String   @id @default(uuid())
  lead_id       String
  activity_type String
  points_added  Int      @default(0)
  description   String?
  created_at    DateTime @default(now())
  lead          Lead     @relation(fields: [lead_id], references: [id])
}

model ScoreRule {
  id             String   @id @default(uuid())
  institution_id String
  activity_type  String
  points         Int
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
  @@unique([institution_id, activity_type])
}

model Task {
  id           String    @id @default(uuid())
  lead_id      String
  assigned_to  String
  title        String
  due_at       DateTime
  is_completed Boolean   @default(false)
  completed_at DateTime?
  created_at   DateTime  @default(now())
  lead         Lead      @relation(fields: [lead_id], references: [id])
  assignee     User      @relation(fields: [assigned_to], references: [id])
}

model Note {
  id         String   @id @default(uuid())
  lead_id    String
  created_by String
  content    String
  created_at DateTime @default(now())
  lead       Lead     @relation(fields: [lead_id], references: [id])
  author     User     @relation(fields: [created_by], references: [id])
}

model EmailTemplate {
  id             String   @id @default(uuid())
  institution_id String
  name           String
  subject        String
  html_body      String
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
}

model WhatsappTemplate {
  id             String   @id @default(uuid())
  institution_id String
  name           String
  message_body   String
  variables      String   @default("[]")
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
}

model CommunicationLog {
  id        String   @id @default(uuid())
  lead_id   String
  channel   String
  direction String   @default("OUTBOUND")
  content   String
  status    String   @default("SENT")
  sent_at   DateTime @default(now())
  lead      Lead     @relation(fields: [lead_id], references: [id])
}

model Workflow {
  id                 String   @id @default(uuid())
  institution_id     String
  name               String
  trigger_event      String
  trigger_conditions String   @default("{}")
  steps              String   @default("[]")
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  institution        Institution @relation(fields: [institution_id], references: [id])
}

model Campaign {
  id             String   @id @default(uuid())
  institution_id String
  name           String
  channel        String
  template_id    String
  target_filter  String   @default("{}")
  status         String   @default("DRAFT")
  sent_count     Int      @default(0)
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
}

model Payment {
  id                  String    @id @default(uuid())
  institution_id      String
  lead_id             String
  amount              Int
  currency            String    @default("INR")
  status              String    @default("PENDING")
  payment_link        String?
  payment_gateway_ref String?
  payment_type        String
  due_date            DateTime?
  paid_at             DateTime?
  created_at          DateTime  @default(now())
  institution         Institution @relation(fields: [institution_id], references: [id])
  lead                Lead      @relation(fields: [lead_id], references: [id])
}

model DeviceToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  platform   String   @default("android")
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
}

model ApplicantPortalUser {
  id             String   @id @default(uuid())
  institution_id String
  lead_id        String   @unique
  email          String
  password_hash  String
  invite_token   String?  @unique
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
  lead           Lead     @relation(fields: [lead_id], references: [id])
}

model Document {
  id               String   @id @default(uuid())
  lead_id          String
  uploaded_by_type String
  uploaded_by_id   String
  file_name        String
  file_url         String
  document_type    String
  uploaded_at      DateTime @default(now())
  lead             Lead     @relation(fields: [lead_id], references: [id])
}

model RefreshToken {
  id         String   @id @default(uuid())
  user_id    String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())
}

model AssignmentConfig {
  id             String   @id @default(uuid())
  institution_id String   @unique
  mode           String   @default("MANUAL")
  counsellors    String   @default("[]")
  updated_at     DateTime @updatedAt
  institution    Institution @relation(fields: [institution_id], references: [id])
}

model AssignmentRule {
  id             String   @id @default(uuid())
  institution_id String
  rule_type      String
  match_value    String
  assigned_to    String
  priority       Int      @default(0)
  created_at     DateTime @default(now())
  institution    Institution @relation(fields: [institution_id], references: [id])
  assignee       User     @relation(fields: [assigned_to], references: [id])
}
